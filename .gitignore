/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-staging/
/.next-build/
/.next-prev/
/.next-ups/
/out/

# production
/build

# misc
.DS_Store
*.pem

