# Relay — environment. Copy to .env.local (dev) or set on the server. Never commit real values.
# Every store is optional: a channel without credentials runs on demo data and says so on /channels.

# ── Server (deploy/docker-compose.yml reads this file as deploy/.env) ─────────────────────────────
# The address people use, without a trailing slash. Caddy gets the HTTPS certificate for DOMAIN.
DOMAIN=
RELAY_PUBLIC_URL=
# Password for the Postgres container beside the app (any long random string).
POSTGRES_PASSWORD=

# ── Staff sign-in with Google ───────────────────────────────────────────────────────────────────
# A Google Cloud OAuth "Web application" client. Authorised redirect URI:
#   <RELAY_PUBLIC_URL>/api/auth/google/callback
# Only emails that already have an account (Team & access) get in. Empty = password sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: a local page stands in for Google so the flow can be tried without a client.
GOOGLE_MOCK=

# ── Database ─────────────────────────────────────────────────────────────────────────────────────
# Leave empty locally: an embedded Postgres (PGlite) lives in .data/. In production, point at Postgres.
DATABASE_URL=

# ── Behaviour ────────────────────────────────────────────────────────────────────────────────────
# Demo mode: one-click sign-in as each department + "Rebuild demo floor". On by default in dev only.
RELAY_DEMO=
# Push changes back to the stores (fulfil with waybill, mark COD paid, relay:<stage> tags). Off by default.
RELAY_WRITE_BACK=false
# Self-hosted schedule: pull every store + ask Aramex every N minutes (webhooks still arrive instantly).
RELAY_SYNC_MINUTES=5
# The AI planner's full pass (minutes, default 360) and how stale the stock screens may get before a
# fresh reading starts behind them (minutes, default 360). "Run the planner now" works at any time.
RELAY_PLAN_MINUTES=
RELAY_STOCK_REFRESH_MINUTES=
# Or call POST /api/cron from an external scheduler with `Authorization: Bearer <this>`.
RELAY_CRON_SECRET=

# ── Ask Relay (Claude) ───────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Shopify stores ───────────────────────────────────────────────────────────────────────────────
# Per store: an Admin API token (custom app in the store admin), OR the app's client id + secret
# (Relay mints a token with the client-credentials grant). Scopes: read_orders, read_customers,
# read_fulfillments (+ read_all_orders for history beyond 60 days). For write-back also write_orders and
# write_merchant_managed_fulfillment_orders. The webhook secret signs order webhooks (see /channels).
RELAY_FIG_WEB_TOKEN=
RELAY_FIG_WEB_CLIENT_ID=
RELAY_FIG_WEB_CLIENT_SECRET=
RELAY_FIG_WEB_WEBHOOK_SECRET=

RELAY_WS_EG_TOKEN=
RELAY_WS_EG_WEBHOOK_SECRET=

RELAY_WS_KW_TOKEN=
RELAY_WS_KW_WEBHOOK_SECRET=

RELAY_LABESNY_WEB_CLIENT_ID=
RELAY_LABESNY_WEB_CLIENT_SECRET=
RELAY_LABESNY_WEB_WEBHOOK_SECRET=

# Women'secret Jordan (d0kb1v-p9): card through HyperPay, delivery by Aramex Amman
RELAY_WS_JO_TOKEN=
RELAY_WS_JO_WEBHOOK_SECRET=

# ── Medusa apps (secret API key from the Medusa admin → Settings → Secret API keys) ──────────────
RELAY_FIG_APP_KEY=
RELAY_FIG_APP_URL=https://fig-fashion-app.medusajs.app
RELAY_LABESNY_APP_KEY=
RELAY_LABESNY_APP_URL=https://labesny-app.medusajs.app

# ── figeg.com (WooCommerce, until the Shopify store launches) ────────────────────────────────────
RELAY_FIG_WOO_KEY=
RELAY_FIG_WOO_SECRET=
RELAY_FIG_WOO_WEBHOOK_SECRET=

# ── Aramex (tracking; shipment creation stays manual until approved) ─────────────────────────────
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=CAI
ARAMEX_ACCOUNT_COUNTRY_CODE=EG

# A country with its own Aramex account uses the same names with its code; others use the ones above.
# Jordan (Aramex Amman, domestic): the API user, account number and PIN come from Aramex's IT team.
ARAMEX_JO_USERNAME=
ARAMEX_JO_PASSWORD=
ARAMEX_JO_ACCOUNT_NUMBER=
ARAMEX_JO_ACCOUNT_PIN=
ARAMEX_JO_ACCOUNT_ENTITY=AMM
ARAMEX_JO_ACCOUNT_COUNTRY_CODE=JO
# Where Aramex picks up in Jordan (printed on the waybill)
ARAMEX_JO_SHIPPER_NAME=
ARAMEX_JO_SHIPPER_PHONE=
ARAMEX_JO_SHIPPER_EMAIL=
ARAMEX_JO_SHIPPER_ADDRESS=
ARAMEX_JO_SHIPPER_CITY=Amman

# ── Lucida ERP (stock by barcode at pick time). One entry per company database; the username picks it.
LUCIDA_ACCOUNTS=[]
# The console's own Lucida call budget per hour (Lucida meters ~60 an hour per login, shared with the website backends).
LUCIDA_CALLS_PER_HOUR=20

# ── Returns portal (/return) ─────────────────────────────────────────────────────────────────────
# The storefronts allowed to embed the portal in one of their own pages, space separated. With
# nothing set only Relay's own origin may frame it, and the shop shows an empty box.
RETURNS_EMBED_ORIGINS=

# ── Sold out comes off the shop ──────────────────────────────────────────────────────────────────
# off (default) does nothing; dry reports what it would draft and publish without touching a shop;
# on drafts sold-out products on every connected storefront and publishes them again when stock
# arrives. It only ever publishes what it drafted itself, which it marks with a relay:oos tag.
RELAY_STOCK_RULE=off

# ── Client advisor (shopping concierge) ─────────────────────────────────────
# The advisor answers with Claude and needs ANTHROPIC_API_KEY above. Without it, every message is
# answered with the WhatsApp hand-off to the team.
# Where Relay is served publicly; the storefront launcher points its frame here.
RELAY_PUBLIC_URL=
# The returns page on labesny.com, once the portal is live; the advisor links shoppers to it.
CONCIERGE_LABESNY_RETURNS_URL=
# Which storefronts may show the advisor (and the returns portal) in a frame, space-separated.
# RETURNS_EMBED_ORIGINS="https://labesny.com"
# Shared with the theme snippet (fig-concierge.liquid): lets the advisor show a signed-in customer
# their own orders and details. Any long random string; empty means everyone is a guest.
CONCIERGE_LABESNY_SECRET=

# UPS Kuwait (GMTC on Shipsy): Labesny's domestic courier. GMTC_ENABLED=true turns booking on.
GMTC_ENABLED=
GMTC_ENV=staging            # staging | live (which GMTC account the key belongs to)
GMTC_API_KEY=
GMTC_CUSTOMER_CODE=
GMTC_HUB_CODE=KUWAITCITY01
GMTC_SERVICE=NEXT DAY       # NEXT DAY | SAME DAY: the service after the same-day cutoff
GMTC_SAME_DAY_BEFORE=14:00  # booked before this Kuwait time → SAME DAY (GMTC picks up at 2 pm); empty = never
GMTC_ORIGIN_PINCODE=Dajeej
GMTC_CREATE_AT=ready        # ready (as soon as an order is ready to pick) | packed | manual
# GMTC_BASE_URL=https://app.shipsy.in   GMTC_SHIPPER_NAME/PHONE/ADDRESS/ADDRESS_2/CITY/STATE override the D&H pickup point
